                            VkPhysicalDevice physical_device);
diff --git a/src/vulkan/wsi/wsi_common_renku.cpp b/src/vulkan/wsi/wsi_common_renku.cpp
new file mode 100644
index 0000000..79aac38
--- /dev/null
+++ b/src/vulkan/wsi/wsi_common_renku.cpp
@@ -0,0 +1,710 @@
+/*
+ * Copyright 2026 rations
+ * SPDX-License-Identifier: MIT
+ */
+
+/** VK_RENKU_surface: Vulkan presentation into a BView on RenkuOS.
+ *
+ * The swapchain renders into Mesa's CPU images (wsi_configure_cpu_image),
+ * as the headless and Win32 software back ends do, so it works with any
+ * driver: lavapipe maps its images, and a GPU driver blits into a host
+ * buffer. A present copies the finished image into a BBitmap and makes that
+ * bitmap the view's view bitmap (BView::SetViewBitmap). app_server keeps a
+ * reference to the bitmap and redraws the view from it by itself whenever
+ * the window is exposed, so the last frame stays on screen with no help
+ * from the application. Each swapchain alternates between two bitmaps: the
+ * one on screen is never written.
+ *
+ * Calls on the view need its window locked. Presents and size queries lock
+ * it with a timeout, because the window's thread may itself be waiting for
+ * the thread that presents. A present that cannot get the lock in time is
+ * dropped, not failed. The view must outlive the surface, and the
+ * application should not draw into it while it is presenting.
+ */
+
+#include <Bitmap.h>
+#include <Looper.h>
+#include <OS.h>
+#include <Screen.h>
+#include <View.h>
+#include <Window.h>
+
+#include <new>
+
+#include <assert.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "util/cnd_monotonic.h"
+#include "util/macros.h"
+#include "util/os_time.h"
+#include "util/timespec.h"
+#include "vk_instance.h"
+#include "vk_physical_device.h"
+#include "vk_util.h"
+#include "wsi_common_entrypoints.h"
+#include "wsi_common_private.h"
+
+/* How long a present, or a size query, waits for the view's window lock. */
+#define WSI_RENKU_LOCK_TIMEOUT 100000 /* microseconds */
+
+struct wsi_renku {
+   struct wsi_interface base;
+};
+
+struct wsi_renku_image {
+   struct wsi_image base;
+   bool acquired; /* by the application, not yet presented or released */
+};
+
+struct wsi_renku_swapchain {
+   struct wsi_swapchain base;
+   BView *view;
+   VkExtent2D extent;
+
+   mtx_t lock; /* the images' acquired flags */
+   struct u_cnd_monotonic cond;
+
+   /* Presents come from one queue at a time (external synchronization). */
+   BBitmap *bitmaps[2];
+   unsigned next_bitmap;
+   bigtime_t frame_time;     /* FIFO: one refresh interval */
+   bigtime_t next_frame;     /* FIFO: when the next present may show */
+
+   struct wsi_renku_image images[0];
+};
+
+/* The size of the view, in pixels, or false if it cannot be known right now:
+ * its window is busy for too long, or the view keeps moving between windows.
+ * A view that is not in a window has no lock to take, and is read as it is.
+ * The view outlives the surface, so the surface is never lost. */
+static bool
+wsi_renku_view_size(BView *view, VkExtent2D *extent)
+{
+   BRect bounds;
+   bool known = false;
+
+   /* LockLooperWithTimeout gives B_MISMATCHED_VALUES when the view moved to
+    * another window while it waited, and B_BAD_VALUE when it has no window,
+    * or its window went: then look again. */
+   for (int attempt = 0; attempt < 3 && !known; attempt++) {
+      status_t status = view->LockLooperWithTimeout(WSI_RENKU_LOCK_TIMEOUT);
+
+      if (status == B_OK) {
+         bounds = view->Bounds();
+         view->UnlockLooper();
+         known = true;
+      } else if (status == B_BAD_VALUE && view->Looper() == NULL) {
+         bounds = view->Bounds();
+         known = true;
+      } else if (status != B_MISMATCHED_VALUES && status != B_BAD_VALUE) {
+         break; /* B_TIMED_OUT: the window is busy */
+      }
+   }
+   if (!known)
+      return false;
+
+   extent->width = MAX2(bounds.IntegerWidth() + 1, 0);
+   extent->height = MAX2(bounds.IntegerHeight() + 1, 0);
+   return true;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+wsi_CreateSurfaceRENKU(VkInstance _instance,
+                       const VkSurfaceCreateInfoRENKU *pCreateInfo,
+                       const VkAllocationCallbacks *pAllocator,
+                       VkSurfaceKHR *pSurface)
+{
+   VK_FROM_HANDLE(vk_instance, instance, _instance);
+   VkIcdSurfaceRenku *surface;
+
+   assert(pCreateInfo->sType == VK_STRUCTURE_TYPE_SURFACE_CREATE_INFO_RENKU);
+
+   if (pCreateInfo->pView == NULL)
+      return VK_ERROR_SURFACE_LOST_KHR;
+
+   surface = (VkIcdSurfaceRenku *)vk_zalloc2(&instance->alloc, pAllocator,
+                                             sizeof(*surface), 8,
+                                             VK_SYSTEM_ALLOCATION_SCOPE_OBJECT);
+   if (surface == NULL)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+   surface->base.platform = VK_ICD_WSI_PLATFORM_RENKU;
+   surface->pView = pCreateInfo->pView;
+
+   *pSurface = VkIcdSurfaceBase_to_handle(&surface->base);
+   return VK_SUCCESS;
+}
+
+static VkResult
+wsi_renku_surface_get_support(VkIcdSurfaceBase *surface,
+                              struct wsi_device *wsi_device,
+                              uint32_t queueFamilyIndex,
+                              VkBool32 *pSupported)
+{
+   *pSupported = true;
+   return VK_SUCCESS;
+}
+
+static VkResult
+wsi_renku_surface_get_capabilities(VkIcdSurfaceBase *icd_surface,
+                                   struct wsi_device *wsi_device,
+                                   VkSurfaceCapabilities2KHR *caps)
+{
+   VkIcdSurfaceRenku *surface = (VkIcdSurfaceRenku *)icd_surface;
+   VkExtent2D extent;
+
+   if (!wsi_renku_view_size(surface->pView, &extent)) {
+      /* Its size is not known right now. */
+      extent.width = extent.height = UINT32_MAX;
+   }
+
+   /* A present copies the image out before it returns, so two images are
+    * enough for any present mode. */
+   caps->surfaceCapabilities.minImageCount = 2;
+   caps->surfaceCapabilities.maxImageCount = 0; /* no real maximum */
+
+   caps->surfaceCapabilities.currentExtent = extent;
+   caps->surfaceCapabilities.minImageExtent = { 1u, 1u };
+   caps->surfaceCapabilities.maxImageExtent = {
+      wsi_device->maxImageDimension2D,
+      wsi_device->maxImageDimension2D,
+   };
+
+   caps->surfaceCapabilities.supportedTransforms = VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR;
+   caps->surfaceCapabilities.currentTransform = VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR;
+   caps->surfaceCapabilities.maxImageArrayLayers = 1;
+
+   /* B_RGB32 has no alpha: the view is opaque. */
+   caps->surfaceCapabilities.supportedCompositeAlpha = VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR;
+
+   VkImageUsageFlags image_usage = wsi_caps_get_image_usage();
+
+   VK_FROM_HANDLE(vk_physical_device, pdevice, wsi_device->pdevice);
+   if (pdevice->supported_extensions.EXT_attachment_feedback_loop_layout)
+      image_usage |= VK_IMAGE_USAGE_ATTACHMENT_FEEDBACK_LOOP_BIT_EXT;
+
+   VkImageUsageFlags2CreateInfoKHR *usage2 = (VkImageUsageFlags2CreateInfoKHR *)
+      vk_find_struct(caps->pNext, IMAGE_USAGE_FLAGS_2_CREATE_INFO_KHR);
+   if (usage2)
+      usage2->usage = image_usage;
+   else
+      caps->surfaceCapabilities.supportedUsageFlags = image_usage;
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+wsi_renku_surface_get_capabilities2(VkIcdSurfaceBase *surface,
+                                    struct wsi_device *wsi_device,
+                                    const void *info_next,
+                                    VkSurfaceCapabilities2KHR *caps)
+{
+   assert(caps->sType == VK_STRUCTURE_TYPE_SURFACE_CAPABILITIES_2_KHR);
+
+   const VkSurfacePresentModeKHR *present_mode = (const VkSurfacePresentModeKHR *)
+      vk_find_struct_const(info_next, SURFACE_PRESENT_MODE_KHR);
+
+   VkResult result = wsi_renku_surface_get_capabilities(surface, wsi_device, caps);
+
+   vk_foreach_struct(sType, ext, caps->pNext) {
+      switch (sType) {
+      case VK_STRUCTURE_TYPE_SURFACE_PROTECTED_CAPABILITIES_KHR: {
+         VkSurfaceProtectedCapabilitiesKHR *protected_cap = (VkSurfaceProtectedCapabilitiesKHR *)ext;
+         protected_cap->supportsProtected = VK_FALSE;
+         break;
+      }
+
+      case VK_STRUCTURE_TYPE_SURFACE_PRESENT_SCALING_CAPABILITIES_KHR: {
+         /* Unsupported */
+         VkSurfacePresentScalingCapabilitiesKHR *scaling = (VkSurfacePresentScalingCapabilitiesKHR *)ext;
+         scaling->supportedPresentScaling = 0;
+         scaling->supportedPresentGravityX = 0;
+         scaling->supportedPresentGravityY = 0;
+         scaling->minScaledImageExtent = caps->surfaceCapabilities.minImageExtent;
+         scaling->maxScaledImageExtent = caps->surfaceCapabilities.maxImageExtent;
+         break;
+      }
+
+      case VK_STRUCTURE_TYPE_SURFACE_PRESENT_MODE_COMPATIBILITY_KHR: {
+         /* Unsupported */
+         VkSurfacePresentModeCompatibilityKHR *compat = (VkSurfacePresentModeCompatibilityKHR *)ext;
+         if (compat->pPresentModes == NULL) {
+            if (!present_mode) {
+               wsi_common_vk_warn_once("Use of VkSurfacePresentModeCompatibilityKHR "
+                                       "without a VkSurfacePresentModeKHR set. This is an "
+                                       "application bug.\n");
+            }
+            compat->presentModeCount = 1;
+         } else if (compat->presentModeCount) {
+            assert(present_mode);
+            compat->presentModeCount = 1;
+            compat->pPresentModes[0] = present_mode->presentMode;
+         }
+         break;
+      }
+
+      case VK_STRUCTURE_TYPE_PRESENT_TIMING_SURFACE_CAPABILITIES_EXT: {
+         VkPresentTimingSurfaceCapabilitiesEXT *wait = (VkPresentTimingSurfaceCapabilitiesEXT *)ext;
+         wait->presentStageQueries = 0;
+         wait->presentTimingSupported = VK_FALSE;
+         wait->presentAtAbsoluteTimeSupported = VK_FALSE;
+         wait->presentAtRelativeTimeSupported = VK_FALSE;
+         break;
+      }
+
+      case VK_STRUCTURE_TYPE_SWAPCHAIN_FLAGS_SURFACE_CAPABILITIES_EXT: {
+         VkSwapchainFlagsSurfaceCapabilitiesEXT *surface_caps = (VkSwapchainFlagsSurfaceCapabilitiesEXT *)ext;
+         VK_FROM_HANDLE(vk_physical_device, pdevice, wsi_device->pdevice);
+
+         if (pdevice->supported_extensions.EXT_multisampled_render_to_swapchain)
+            surface_caps->swapchainSupportedFlags |= VK_SWAPCHAIN_CREATE_MULTISAMPLED_RENDER_TO_SINGLE_SAMPLED_BIT_EXT;
+         if (pdevice->supported_extensions.KHR_bind_memory2)
+            surface_caps->swapchainSupportedFlags |= VK_SWAPCHAIN_CREATE_SPLIT_INSTANCE_BIND_REGIONS_BIT_KHR;
+         if (pdevice->supported_extensions.KHR_present_id2)
+            surface_caps->swapchainSupportedFlags |= VK_SWAPCHAIN_CREATE_PRESENT_ID_2_BIT_KHR;
+         if (pdevice->supported_extensions.KHR_present_wait2)
+            surface_caps->swapchainSupportedFlags |= VK_SWAPCHAIN_CREATE_PRESENT_WAIT_2_BIT_KHR;
+         if (pdevice->supported_extensions.KHR_swapchain_mutable_format)
+            surface_caps->swapchainSupportedFlags |= VK_SWAPCHAIN_CREATE_MUTABLE_FORMAT_BIT_KHR;
+         if (pdevice->supported_extensions.EXT_present_timing)
+            surface_caps->swapchainSupportedFlags |= VK_SWAPCHAIN_CREATE_PRESENT_TIMING_BIT_EXT;
+         if (pdevice->supported_extensions.KHR_swapchain_maintenance1 ||
+             pdevice->supported_extensions.EXT_swapchain_maintenance1)
+            surface_caps->swapchainSupportedFlags |= VK_SWAPCHAIN_CREATE_DEFERRED_MEMORY_ALLOCATION_BIT_EXT;
+         break;
+      }
+
+      case VK_STRUCTURE_TYPE_SURFACE_CAPABILITIES_PRESENT_ID_2_KHR: {
+         VkSurfaceCapabilitiesPresentId2KHR *pid2 = (VkSurfaceCapabilitiesPresentId2KHR *)ext;
+         pid2->presentId2Supported = VK_TRUE;
+         break;
+      }
+
+      case VK_STRUCTURE_TYPE_SURFACE_CAPABILITIES_PRESENT_WAIT_2_KHR: {
+         VkSurfaceCapabilitiesPresentWait2KHR *pwait2 = (VkSurfaceCapabilitiesPresentWait2KHR *)ext;
+         pwait2->presentWait2Supported = VK_TRUE;
+         break;
+      }
+
+      default:
+         /* Ignored */
+         break;
+      }
+   }
+
+   return result;
+}
+
+/* B_RGB32 is B, G, R, X in memory, so only BGRA formats show the right
+ * colours without a conversion. */
+static const VkFormat available_surface_formats[] = {
+   VK_FORMAT_B8G8R8A8_UNORM,
+   VK_FORMAT_B8G8R8A8_SRGB,
+};
+
+static VkResult
+wsi_renku_surface_get_formats(VkIcdSurfaceBase *icd_surface,
+                              struct wsi_device *wsi_device,
+                              uint32_t *pSurfaceFormatCount,
+                              VkSurfaceFormatKHR *pSurfaceFormats)
+{
+   VK_OUTARRAY_MAKE_TYPED(VkSurfaceFormatKHR, out, pSurfaceFormats, pSurfaceFormatCount);
+
+   for (unsigned i = 0; i < ARRAY_SIZE(available_surface_formats); i++) {
+      vk_outarray_append_typed(VkSurfaceFormatKHR, &out, f) {
+         f->format = available_surface_formats[i];
+         f->colorSpace = VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;
+      }
+   }
+
+   return vk_outarray_status(&out);
+}
+
+static VkResult
+wsi_renku_surface_get_formats2(VkIcdSurfaceBase *icd_surface,
+                               struct wsi_device *wsi_device,
+                               const void *info_next,
+                               uint32_t *pSurfaceFormatCount,
+                               VkSurfaceFormat2KHR *pSurfaceFormats)
+{
+   VK_OUTARRAY_MAKE_TYPED(VkSurfaceFormat2KHR, out, pSurfaceFormats, pSurfaceFormatCount);
+
+   for (unsigned i = 0; i < ARRAY_SIZE(available_surface_formats); i++) {
+      vk_outarray_append_typed(VkSurfaceFormat2KHR, &out, f) {
+         assert(f->sType == VK_STRUCTURE_TYPE_SURFACE_FORMAT_2_KHR);
+         f->surfaceFormat.format = available_surface_formats[i];
+         f->surfaceFormat.colorSpace = VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;
+      }
+   }
+
+   return vk_outarray_status(&out);
+}
+
+static const VkPresentModeKHR present_modes[] = {
+   VK_PRESENT_MODE_FIFO_KHR,
+   VK_PRESENT_MODE_IMMEDIATE_KHR,
+   VK_PRESENT_MODE_MAILBOX_KHR,
+};
+
+static VkResult
+wsi_renku_surface_get_present_modes(VkIcdSurfaceBase *surface,
+                                    struct wsi_device *wsi_device,
+                                    uint32_t *pPresentModeCount,
+                                    VkPresentModeKHR *pPresentModes)
+{
+   if (pPresentModes == NULL) {
+      *pPresentModeCount = ARRAY_SIZE(present_modes);
+      return VK_SUCCESS;
+   }
+
+   *pPresentModeCount = MIN2(*pPresentModeCount, ARRAY_SIZE(present_modes));
+   typed_memcpy(pPresentModes, present_modes, *pPresentModeCount);
+
+   return *pPresentModeCount < ARRAY_SIZE(present_modes) ? VK_INCOMPLETE : VK_SUCCESS;
+}
+
+static VkResult
+wsi_renku_surface_get_present_rectangles(VkIcdSurfaceBase *icd_surface,
+                                         struct wsi_device *wsi_device,
+                                         uint32_t *pRectCount,
+                                         VkRect2D *pRects)
+{
+   VkIcdSurfaceRenku *surface = (VkIcdSurfaceRenku *)icd_surface;
+   VK_OUTARRAY_MAKE_TYPED(VkRect2D, out, pRects, pRectCount);
+   VkExtent2D extent;
+
+   if (!wsi_renku_view_size(surface->pView, &extent))
+      extent.width = extent.height = UINT32_MAX;
+
+   vk_outarray_append_typed(VkRect2D, &out, rect) {
+      rect->offset = { 0, 0 };
+      rect->extent = extent;
+   }
+
+   return vk_outarray_status(&out);
+}
+
+static struct wsi_image *
+wsi_renku_swapchain_get_wsi_image(struct wsi_swapchain *wsi_chain,
+                                  uint32_t image_index)
+{
+   struct wsi_renku_swapchain *chain = (struct wsi_renku_swapchain *)wsi_chain;
+   return &chain->images[image_index].base;
+}
+
+static void
+wsi_renku_release_image(struct wsi_renku_swapchain *chain, uint32_t index)
+{
+   mtx_lock(&chain->lock);
+   chain->images[index].acquired = false;
+   u_cnd_monotonic_broadcast(&chain->cond);
+   mtx_unlock(&chain->lock);
+}
+
+static VkResult
+wsi_renku_swapchain_release_images(struct wsi_swapchain *wsi_chain,
+                                   uint32_t count, const uint32_t *indices)
+{
+   struct wsi_renku_swapchain *chain = (struct wsi_renku_swapchain *)wsi_chain;
+
+   for (uint32_t i = 0; i < count; i++) {
+      assert(indices[i] < chain->base.image_count);
+      wsi_renku_release_image(chain, indices[i]);
+   }
+   return VK_SUCCESS;
+}
+
+static bool
+wsi_renku_find_idle_image(struct wsi_renku_swapchain *chain, uint32_t *index)
+{
+   for (uint32_t i = 0; i < chain->base.image_count; i++) {
+      if (!chain->images[i].acquired) {
+         chain->images[i].acquired = true;
+         *index = i;
+         return true;
+      }
+   }
+   return false;
+}
+
+static VkResult
+wsi_renku_swapchain_acquire_next_image(struct wsi_swapchain *wsi_chain,
+                                       const VkAcquireNextImageInfoKHR *info,
+                                       uint32_t *image_index)
+{
+   struct wsi_renku_swapchain *chain = (struct wsi_renku_swapchain *)wsi_chain;
+   VkResult result = VK_SUCCESS;
+
+   mtx_lock(&chain->lock);
+   if (!wsi_renku_find_idle_image(chain, image_index)) {
+      if (info->timeout == 0) {
+         result = VK_NOT_READY;
+      } else {
+         struct timespec abs_timeout;
+         timespec_from_nsec(&abs_timeout, os_time_get_absolute_timeout(info->timeout));
+         do {
+            int ret = u_cnd_monotonic_timedwait(&chain->cond, &chain->lock, &abs_timeout);
+            if (ret == thrd_timedout) {
+               result = VK_TIMEOUT;
+               break;
+            } else if (ret != thrd_success) {
+               result = VK_ERROR_OUT_OF_DATE_KHR;
+               break;
+            }
+         } while (!wsi_renku_find_idle_image(chain, image_index));
+      }
+   }
+   mtx_unlock(&chain->lock);
+   return result;
+}
+
+/* Copies an image into the bitmap that is not on screen. */
+static BBitmap *
+wsi_renku_fill_bitmap(struct wsi_renku_swapchain *chain, struct wsi_renku_image *image)
+{
+   BBitmap *bitmap = chain->bitmaps[chain->next_bitmap];
+   const uint8_t *src = (const uint8_t *)image->base.cpu_map;
+   uint8_t *dst = (uint8_t *)bitmap->Bits();
+   const size_t src_pitch = image->base.row_pitches[0];
+   const size_t dst_pitch = bitmap->BytesPerRow();
+   const size_t row = (size_t)chain->extent.width * 4;
+
+   for (uint32_t y = 0; y < chain->extent.height; y++)
+      memcpy(dst + y * dst_pitch, src + y * src_pitch, row);
+
+   return bitmap;
+}
+
+static VkResult
+wsi_renku_swapchain_queue_present(struct wsi_swapchain *wsi_chain,
+                                  uint32_t image_index,
+                                  uint64_t present_id,
+                                  const VkPresentRegionKHR *damage)
+{
+   struct wsi_renku_swapchain *chain = (struct wsi_renku_swapchain *)wsi_chain;
+   struct wsi_renku_image *image = &chain->images[image_index];
+   VkResult result = VK_SUCCESS;
+
+   assert(image_index < chain->base.image_count);
+
+   BBitmap *bitmap = wsi_renku_fill_bitmap(chain, image);
+
+   /* The image is copied out: the application may have it back. */
+   wsi_renku_release_image(chain, image_index);
+
+   if (chain->base.present_mode == VK_PRESENT_MODE_FIFO_KHR) {
+      /* No present shows sooner than one refresh interval after the one
+       * before it. */
+      bigtime_t now = system_time();
+      if (chain->next_frame > now)
+         snooze_until(chain->next_frame, B_SYSTEM_TIMEBASE);
+      chain->next_frame = MAX2(now, chain->next_frame) + chain->frame_time;
+   }
+
+   BView *view = chain->view;
+   if (view->LockLooperWithTimeout(WSI_RENKU_LOCK_TIMEOUT) != B_OK)
+      return VK_SUCCESS; /* the window is busy or gone: the frame is dropped */
+
+   BRect frame(0, 0, chain->extent.width - 1, chain->extent.height - 1);
+   view->SetViewBitmap(bitmap, frame, frame, B_FOLLOW_TOP | B_FOLLOW_LEFT, 0);
+   /* app_server has taken the bitmap once this returns, so the other one
+    * can be written. A dropped frame leaves the one on screen as it is. */
+   view->Sync();
+   chain->next_bitmap ^= 1;
+
+   BRect bounds = view->Bounds();
+   if ((uint32_t)bounds.IntegerWidth() + 1 != chain->extent.width ||
+       (uint32_t)bounds.IntegerHeight() + 1 != chain->extent.height)
+      result = VK_SUBOPTIMAL_KHR;
+
+   view->UnlockLooper();
+   return result;
+}
+
+static VkResult
+wsi_renku_swapchain_wait_for_present(struct wsi_swapchain *wsi_chain,
+                                     uint64_t waitValue,
+                                     uint64_t timeout)
+{
+   return wsi_swapchain_wait_for_present_semaphore(wsi_chain, waitValue, timeout);
+}
+
+static VkResult
+wsi_renku_swapchain_destroy(struct wsi_swapchain *wsi_chain,
+                            const VkAllocationCallbacks *pAllocator)
+{
+   struct wsi_renku_swapchain *chain = (struct wsi_renku_swapchain *)wsi_chain;
+
+   for (uint32_t i = 0; i < chain->base.image_count; i++)
+      wsi_destroy_image(&chain->base, &chain->images[i].base);
+
+   /* The view may still show one of the bitmaps: app_server holds its own
+    * reference, so it stays on screen until the next swapchain's first
+    * present, or until the surface is destroyed. */
+   delete chain->bitmaps[0];
+   delete chain->bitmaps[1];
+
+   wsi_swapchain_finish(&chain->base);
+   u_cnd_monotonic_destroy(&chain->cond);
+   mtx_destroy(&chain->lock);
+   vk_free(pAllocator, chain);
+   return VK_SUCCESS;
+}
+
+/* One refresh interval of the screen the view is on, for FIFO. */
+static bigtime_t
+wsi_renku_frame_time(BView *view)
+{
+   display_mode mode;
+   bigtime_t frame_time = 1000000 / 60;
+
+   BScreen screen(B_MAIN_SCREEN_ID);
+   if (screen.IsValid() && screen.GetMode(&mode) == B_OK &&
+       mode.timing.pixel_clock && mode.timing.h_total && mode.timing.v_total) {
+      /* pixel_clock is in kHz */
+      uint64_t pixels = (uint64_t)mode.timing.h_total * mode.timing.v_total;
+      bigtime_t t = (bigtime_t)(pixels * 1000 / mode.timing.pixel_clock);
+      if (t >= 1000 && t <= 100000) /* 10 to 1000 Hz */
+         frame_time = t;
+   }
+   return frame_time;
+}
+
+static VkResult
+wsi_renku_surface_create_swapchain(VkIcdSurfaceBase *icd_surface,
+                                   VkDevice device,
+                                   struct wsi_device *wsi_device,
+                                   const VkSwapchainCreateInfoKHR *pCreateInfo,
+                                   const VkAllocationCallbacks *pAllocator,
+                                   struct wsi_swapchain **swapchain_out)
+{
+   VkIcdSurfaceRenku *surface = (VkIcdSurfaceRenku *)icd_surface;
+   struct wsi_renku_swapchain *chain;
+   VkResult result;
+
+   assert(pCreateInfo->sType == VK_STRUCTURE_TYPE_SWAPCHAIN_CREATE_INFO_KHR);
+
+   if (pCreateInfo->imageFormat != VK_FORMAT_B8G8R8A8_UNORM &&
+       pCreateInfo->imageFormat != VK_FORMAT_B8G8R8A8_SRGB)
+      return VK_ERROR_FORMAT_NOT_SUPPORTED;
+
+   const uint32_t num_images = MAX2(pCreateInfo->minImageCount, 2);
+   size_t size = sizeof(*chain) + num_images * sizeof(chain->images[0]);
+
+   chain = (struct wsi_renku_swapchain *)vk_zalloc(pAllocator, size, 8,
+                                                   VK_SYSTEM_ALLOCATION_SCOPE_OBJECT);
+   if (chain == NULL)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+   if (mtx_init(&chain->lock, mtx_plain) != thrd_success) {
+      vk_free(pAllocator, chain);
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   }
+   if (u_cnd_monotonic_init(&chain->cond) != thrd_success) {
+      mtx_destroy(&chain->lock);
+      vk_free(pAllocator, chain);
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   }
+
+   struct wsi_cpu_image_params cpu_params = {};
+   cpu_params.base.image_type = WSI_IMAGE_TYPE_CPU;
+
+   result = wsi_swapchain_init(wsi_device, &chain->base, device,
+                               pCreateInfo, &cpu_params.base, pAllocator);
+   if (result != VK_SUCCESS) {
+      u_cnd_monotonic_destroy(&chain->cond);
+      mtx_destroy(&chain->lock);
+      vk_free(pAllocator, chain);
+      return result;
+   }
+
+   chain->base.destroy = wsi_renku_swapchain_destroy;
+   chain->base.get_wsi_image = wsi_renku_swapchain_get_wsi_image;
+   chain->base.acquire_next_image = wsi_renku_swapchain_acquire_next_image;
+   chain->base.release_images = wsi_renku_swapchain_release_images;
+   chain->base.queue_present = wsi_renku_swapchain_queue_present;
+   chain->base.wait_for_present = wsi_renku_swapchain_wait_for_present;
+   chain->base.wait_for_present2 = wsi_renku_swapchain_wait_for_present;
+   chain->base.present_mode = wsi_swapchain_get_present_mode(wsi_device, pCreateInfo);
+
+   chain->view = surface->pView;
+   chain->extent = pCreateInfo->imageExtent;
+   chain->frame_time = wsi_renku_frame_time(chain->view);
+
+   /* A BBitmap needs the application's connection to app_server, which any
+    * program with a window has. */
+   BRect frame(0, 0, chain->extent.width - 1, chain->extent.height - 1);
+   for (unsigned i = 0; i < 2; i++) {
+      chain->bitmaps[i] = new (std::nothrow) BBitmap(frame, 0, B_RGB32);
+      if (chain->bitmaps[i] == NULL || chain->bitmaps[i]->InitCheck() != B_OK) {
+         result = VK_ERROR_OUT_OF_HOST_MEMORY;
+         goto fail;
+      }
+   }
+
+   for (uint32_t i = 0; i < num_images; i++) {
+      result = wsi_create_image(&chain->base, &chain->base.image_info,
+                                &chain->images[i].base);
+      if (result != VK_SUCCESS)
+         goto fail;
+      chain->base.image_count++;
+   }
+
+   *swapchain_out = &chain->base;
+   return VK_SUCCESS;
+
+fail:
+   wsi_renku_swapchain_destroy(&chain->base, pAllocator);
+   return result;
+}
+
+void
+wsi_renku_surface_destroy(VkIcdSurfaceBase *icd_surface, VkInstance _instance,
+                          const VkAllocationCallbacks *pAllocator)
+{
+   VK_FROM_HANDLE(vk_instance, instance, _instance);
+   VkIcdSurfaceRenku *surface = (VkIcdSurfaceRenku *)icd_surface;
+
+   /* Takes the last frame off the view. */
+   if (surface->pView->LockLooperWithTimeout(WSI_RENKU_LOCK_TIMEOUT) == B_OK) {
+      surface->pView->ClearViewBitmap();
+      surface->pView->UnlockLooper();
+   }
+
+   vk_free2(&instance->alloc, pAllocator, surface);
+}
+
+VkResult
+wsi_renku_init_wsi(struct wsi_device *wsi_device,
+                   const VkAllocationCallbacks *alloc,
+                   VkPhysicalDevice physical_device)
+{
+   struct wsi_renku *wsi = (struct wsi_renku *)
+      vk_zalloc(alloc, sizeof(*wsi), 8, VK_SYSTEM_ALLOCATION_SCOPE_INSTANCE);
+   if (wsi == NULL) {
+      wsi_device->wsi[VK_ICD_WSI_PLATFORM_RENKU] = NULL;
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   }
+
+   wsi->base.get_support = wsi_renku_surface_get_support;
+   wsi->base.get_capabilities2 = wsi_renku_surface_get_capabilities2;
+   wsi->base.get_formats = wsi_renku_surface_get_formats;
+   wsi->base.get_formats2 = wsi_renku_surface_get_formats2;
+   wsi->base.get_present_modes = wsi_renku_surface_get_present_modes;
+   wsi->base.get_present_rectangles = wsi_renku_surface_get_present_rectangles;
+   wsi->base.create_swapchain = wsi_renku_surface_create_swapchain;
+
+   wsi_device->wsi[VK_ICD_WSI_PLATFORM_RENKU] = &wsi->base;
+   return VK_SUCCESS;
+}
+
+void
+wsi_renku_finish_wsi(struct wsi_device *wsi_device,
+                     const VkAllocationCallbacks *alloc)
+{
+   struct wsi_renku *wsi = (struct wsi_renku *)wsi_device->wsi[VK_ICD_WSI_PLATFORM_RENKU];
+   if (wsi == NULL)
+      return;
+   vk_free(alloc, wsi);
+}
-- 
