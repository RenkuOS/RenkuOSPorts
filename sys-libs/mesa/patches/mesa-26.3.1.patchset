+    VkInstance                                  instance,
+    const VkSurfaceCreateInfoRENKU*             pCreateInfo,
+    const VkAllocationCallbacks*                pAllocator,
+    VkSurfaceKHR*                               pSurface);
+#endif
+#endif
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
