From 366f3f93d1c1113f3ac1efb86d6ba54337970c89 Mon Sep 17 00:00:00 2001
From: Ian <idumych@gmail.com>
Date: Sun, 22 Nov 2026 22:16:24 -0800
Subject: [PATCH 3/3] Haiku: don't restart a join to the network we are on

When the access point drops us, the supplicant reconnects by itself.
But net_server also sends a join request for the network on its next
scan, without the password and the authentication mode. The supplicant
then asked for the password again, and joining with it removed the
network and added it anew, which tore down the connection the
supplicant had just made by itself. The user saw the password being
refused over and over.

The application now remembers, for this session, the password and
authentication mode of each network joined with one, and fills them into
a later join request that lacks them. And a join request for the network
the interface is already set up for, with the same password, while it is
connected or busy connecting, no longer starts over: it only waits for
(or reports at once) the completion.

Assisted-by: claude-opus-5-5
Signed-off-by: Ian <idumych@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01PoWUVNAjBS5LqoUC1otv9w
---
 wpa_supplicant/wpa_gui-haiku/main_haiku.cpp | 85 +++++++++++++++++++++
 1 file changed, 85 insertions(+)

diff --git a/wpa_supplicant/wpa_gui-haiku/main_haiku.cpp b/wpa_supplicant/wpa_gui-haiku/main_haiku.cpp
index 38f9c09..90c6538 100644
--- a/wpa_supplicant/wpa_gui-haiku/main_haiku.cpp
+++ b/wpa_supplicant/wpa_gui-haiku/main_haiku.cpp
@@ -130,6 +130,8 @@ static	void					_EventLoopProcessEvents(int sock,
 		bool					_CheckAskForConfig(BMessage *message);
 
 		status_t				_JoinNetwork(BMessage *message);
+		bool					_IsAlreadyJoining(wpa_supplicant *interface,
+									BMessage *message);
 		status_t				_LeaveNetwork(BMessage *message);
 
 		status_t				_NotifyNetworkEvent(BMessage *message);
@@ -162,6 +164,13 @@ static	void					_SendReplyIfNeeded(BMessage &message,
 								fWatchingEntryList;
 		BLocker					fWatchingEntryListLocker;
 
+			// Networks joined with a password during this session, by name:
+			// "authentication" and "password" for each, so that a join request
+			// without them (net_server's auto-join after the access point
+			// dropped us) doesn't ask for the password again. Only used from
+			// the application thread.
+		BMessage				fSessionNetworks;
+
 		wpa_global *			fWPAGlobal;
 		wpa_params				fWPAParameters;
 };
@@ -247,6 +256,20 @@ WPASupplicantApp::MessageReceived(BMessage *message)
 				}
 			}
 
+			const char *name = NULL;
+			uint32 authentication;
+			const char *password = NULL;
+			if (message->FindString("name", &name) == B_OK
+				&& message->FindUInt32("authentication", &authentication)
+					== B_OK
+				&& message->FindString("password", &password) == B_OK) {
+				BMessage known;
+				known.AddUInt32("authentication", authentication);
+				known.AddString("password", password);
+				fSessionNetworks.RemoveName(name);
+				fSessionNetworks.AddMessage(name, &known);
+			}
+
 			_EnqueueAndNotify(DetachCurrentMessage());
 				// The event processing code will send the reply.
 			return;
@@ -425,6 +448,19 @@ WPASupplicantApp::_CheckAskForConfig(BMessage *message)
 	if (!message->HasString("name"))
 		return true;
 
+	BMessage known;
+	if ((!message->HasString("password")
+			|| !message->HasUInt32("authentication"))
+		&& fSessionNetworks.FindMessage(message->FindString("name"), &known)
+			== B_OK) {
+		message->RemoveName("authentication");
+		message->RemoveName("password");
+		message->AddUInt32("authentication", known.GetUInt32("authentication",
+			B_NETWORK_AUTHENTICATION_NONE));
+		message->AddString("password", known.GetString("password", ""));
+		return false;
+	}
+
 	uint32 authMode = B_NETWORK_AUTHENTICATION_NONE;
 	if (message->FindUInt32("authentication", &authMode) != B_OK)
 		return true;
@@ -451,6 +487,43 @@ WPASupplicantApp::_CheckAskForConfig(BMessage *message)
 }
 
 
+/*!	Whether \a interface is already set up for the network \a message asks
+	to join, with the same password, and is connected or busy connecting to
+	it. Called from the event loop only.
+*/
+bool
+WPASupplicantApp::_IsAlreadyJoining(wpa_supplicant *interface,
+	BMessage *message)
+{
+	const char *name = NULL;
+	if (message->FindString("name", &name) != B_OK)
+		return false;
+	const char *password = message->GetString("password", NULL);
+
+	wpa_ssid *network = wpa_config_get_network(interface->conf, 0);
+	if (network == NULL || network->disabled
+		|| wpa_config_get_network(interface->conf, 1) != NULL)
+		return false;
+
+	size_t nameLength = strlen(name);
+	if (network->ssid_len != nameLength
+		|| memcmp(network->ssid, name, nameLength) != 0)
+		return false;
+
+	if (password != NULL) {
+		if (network->passphrase == NULL
+			|| strcmp(network->passphrase, password) != 0)
+			return false;
+	} else if (network->passphrase != NULL || network->psk_set)
+		return false;
+
+	// Inactive or disabled means nothing is in progress; otherwise we are
+	// connected, connecting, or between our own reconnection attempts.
+	return interface->wpa_state != WPA_INACTIVE
+		&& interface->wpa_state != WPA_INTERFACE_DISABLED;
+}
+
+
 status_t
 WPASupplicantApp::_JoinNetwork(BMessage *message)
 {
@@ -470,6 +543,18 @@ WPASupplicantApp::_JoinNetwork(BMessage *message)
 
 		interface = wpa_supplicant_add_iface(fWPAGlobal, &interfaceOptions,
 			NULL);
+	} else if (_IsAlreadyJoining(interface, message)) {
+		// Asked to join the network we are already connected to, or
+		// reconnecting to by ourselves (net_server's auto-join after the
+		// access point dropped us): starting over would only tear that
+		// connection down. Just report when it completes.
+		_StartWatchingInterfaceChanges(interface,
+			_InterfaceStateChangeCallback, message);
+		if (interface->wpa_state == WPA_COMPLETED) {
+			wpa_supplicant_haiku_notify_state_change(interface, WPA_COMPLETED,
+				WPA_COMPLETED);
+		}
+		return B_OK;
 	} else {
 		// Disable everything
 		wpa_supplicant_disable_network(interface, NULL);
-- 
